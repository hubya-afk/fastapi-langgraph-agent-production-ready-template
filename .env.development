# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://127.0.0.1:3000,http://127.0.0.1:8080"

# Langfuse Settings

LANGFUSE_BASE_URL="http://127.0.0.1:3000"
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY="pk-lf-b0d126c7-4226-4dac-a529-77b158117a08"
LANGFUSE_SECRET_KEY="sk-lf-5073f82e-6a11-48ff-8b14-a2e3861853eb"
LANGFUSE_HOST="http://127.0.0.1:3000"

# LLM Settings
OPENAI_API_KEY="xxxxx" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LONG_TERM_MEMORY_MODEL=deepseek-v4-flash
LONG_TERM_MEMORY_EMBEDDER_MODEL=doubao-embedding-vision
# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# JWT Settings
JWT_SECRET_KEY="a7Kp9Xm2Qv8Ls4Nz1Rc6Ty5Hu3Wd0EfG"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=agent
POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=123456
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
